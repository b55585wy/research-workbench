# Optional runtime paths. systemd reads this file as root.
# Store model credentials through the application settings; they belong to
# /var/lib/research-workspace/data/.agent-model.json (service user, mode0600).
# An external RESEARCH_AGENT_CONFIG must also be readable by that service user.
#RESEARCH_IMPORT_ROOT=/opt/research-workspace/runtimes/import-v1
#RESEARCH_TRANSLATION_RUNTIME=/opt/research-workspace/runtimes/translation
# Rscript/statistics-root are explicit arguments in research-workbench.service.
